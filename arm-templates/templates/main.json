{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Orchestrator for the dataplatform landing zone. Composes the linked modules under ./modules into one resource group deployment and is published as a Template Spec so the same template serves dev, ite, iqe, preprod and prod through parameter files.",
    "author": "Tahsin Khan"
  },
  "parameters": {
    "environment": {
      "type": "string",
      "allowedValues": [
        "dev",
        "ite",
        "iqe",
        "preprod",
        "prod"
      ],
      "metadata": {
        "description": "Target environment code. Drives naming, tagging and the production-like hardening switches."
      }
    },
    "platformName": {
      "type": "string",
      "defaultValue": "dataplatform",
      "minLength": 3,
      "maxLength": 16,
      "metadata": {
        "description": "Workload name used in resource names."
      }
    },
    "orgPrefix": {
      "type": "string",
      "defaultValue": "dp",
      "minLength": 2,
      "maxLength": 4,
      "metadata": {
        "description": "Short organisation prefix used in resource names."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources. Defaults to the resource group location."
      }
    },
    "resourceNameSuffix": {
      "type": "string",
      "defaultValue": "[take(uniqueString(resourceGroup().id), 6)]",
      "minLength": 3,
      "maxLength": 8,
      "metadata": {
        "description": "Suffix that keeps globally unique names (storage, Key Vault, Data Factory) stable per resource group. Override only when importing existing resources."
      }
    },
    "vnetAddressPrefix": {
      "type": "string",
      "metadata": {
        "description": "Address space of the platform virtual network."
      }
    },
    "databricksPublicSubnetPrefix": {
      "type": "string",
      "metadata": {
        "description": "CIDR for the Databricks host subnet."
      }
    },
    "databricksPrivateSubnetPrefix": {
      "type": "string",
      "metadata": {
        "description": "CIDR for the Databricks container subnet."
      }
    },
    "privateEndpointSubnetPrefix": {
      "type": "string",
      "metadata": {
        "description": "CIDR for the private endpoint subnet."
      }
    },
    "storageSkuName": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": [
        "Standard_LRS",
        "Standard_ZRS",
        "Standard_GRS",
        "Standard_RAGRS",
        "Standard_GZRS",
        "Standard_RAGZRS"
      ],
      "metadata": {
        "description": "Replication type for the data lake account."
      }
    },
    "storageContainerNames": {
      "type": "array",
      "defaultValue": [
        "landing",
        "bronze",
        "silver",
        "gold"
      ],
      "metadata": {
        "description": "Data lake containers to create."
      }
    },
    "coolTierAfterDays": {
      "type": "int",
      "defaultValue": 30,
      "minValue": 1,
      "maxValue": 365,
      "metadata": {
        "description": "Days before landing and bronze blobs are tiered to Cool."
      }
    },
    "deleteLandingAfterDays": {
      "type": "int",
      "defaultValue": 90,
      "minValue": 1,
      "maxValue": 3650,
      "metadata": {
        "description": "Days before landing blobs are deleted."
      }
    },
    "logRetentionInDays": {
      "type": "int",
      "defaultValue": 30,
      "minValue": 30,
      "maxValue": 730,
      "metadata": {
        "description": "Log Analytics interactive retention."
      }
    },
    "logDailyQuotaGb": {
      "type": "int",
      "defaultValue": -1,
      "minValue": -1,
      "maxValue": 5000,
      "metadata": {
        "description": "Log Analytics daily ingestion cap in GB; -1 for unlimited."
      }
    },
    "keyVaultSkuName": {
      "type": "string",
      "defaultValue": "standard",
      "allowedValues": [
        "standard",
        "premium"
      ],
      "metadata": {
        "description": "Key Vault SKU."
      }
    },
    "enableKeyVaultPurgeProtection": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Purge protection for the platform Key Vault. Irreversible once enabled."
      }
    },
    "databricksPricingTier": {
      "type": "string",
      "defaultValue": "premium",
      "allowedValues": [
        "standard",
        "premium",
        "trial"
      ],
      "metadata": {
        "description": "Databricks workspace SKU."
      }
    },
    "enableDataFactoryGit": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Attach Data Factory to Git. True for dev only; other environments are deployment targets for published artefacts."
      }
    },
    "dataFactoryGit": {
      "type": "object",
      "defaultValue": {
        "accountName": "dp-devops-org",
        "projectName": "DataPlatform",
        "repositoryName": "dataplatform-adf",
        "collaborationBranch": "main",
        "rootFolder": "/adf"
      },
      "metadata": {
        "description": "Azure DevOps Git settings for Data Factory. Used only when enableDataFactoryGit is true."
      }
    },
    "deployPrivateEndpoints": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Deploy private endpoints for storage and Key Vault and disable their public endpoints. Enabled for preprod and prod."
      }
    },
    "allowedIpRanges": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Public IP ranges permitted through the storage and Key Vault firewalls, e.g. office and build agent egress."
      }
    },
    "keyVaultReaderPrincipalIds": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Additional principal object IDs granted Key Vault Secrets User. The Data Factory managed identity is always included."
      }
    },
    "servicePrincipalClientSecret": {
      "type": "secureString",
      "metadata": {
        "description": "Client secret of the platform service principal, seeded into Key Vault. Supplied via a Key Vault reference in the parameter file, never as plain text."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags merged with the standard platform tags and applied to every resource."
      }
    }
  },
  "variables": {
    "namePrefix": "[format('{0}-{1}-{2}', parameters('orgPrefix'), parameters('platformName'), parameters('environment'))]",
    "isProductionLike": "[contains(createArray('preprod', 'prod'), parameters('environment'))]",
    "names": {
      "vnet": "[format('vnet-{0}', variables('namePrefix'))]",
      "nsg": "[format('nsg-{0}-dbw', variables('namePrefix'))]",
      "logAnalytics": "[format('log-{0}', variables('namePrefix'))]",
      "storage": "[toLower(format('{0}{1}lake{2}', parameters('orgPrefix'), parameters('environment'), parameters('resourceNameSuffix')))]",
      "keyVault": "[format('kv-{0}-{1}-{2}', parameters('orgPrefix'), parameters('environment'), parameters('resourceNameSuffix'))]",
      "databricks": "[format('dbw-{0}', variables('namePrefix'))]",
      "databricksManagedRg": "[format('rg-{0}-dbw-managed', variables('namePrefix'))]",
      "dataFactory": "[format('adf-{0}-{1}', variables('namePrefix'), parameters('resourceNameSuffix'))]"
    },
    "deployments": {
      "networking": "[format('{0}-networking', deployment().name)]",
      "logAnalytics": "[format('{0}-loganalytics', deployment().name)]",
      "storage": "[format('{0}-storage', deployment().name)]",
      "keyVault": "[format('{0}-keyvault', deployment().name)]",
      "dataFactory": "[format('{0}-datafactory', deployment().name)]",
      "databricks": "[format('{0}-databricks', deployment().name)]",
      "keyVaultAccess": "[format('{0}-keyvault-access', deployment().name)]"
    },
    "commonTags": "[union(parameters('tags'), createObject('environment', parameters('environment'), 'platform', parameters('platformName'), 'managedBy', 'arm-template', 'templateVersion', deployment().properties.template.contentVersion))]",
    "keyVaultSecretsUserRoleId": "4633458b-17de-408a-b874-0445c86b69e6",
    "spSecretName": "[format('{0}-sp-client-secret', parameters('platformName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[variables('deployments').networking]",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "relativePath": "modules/networking.json"
        },
        "parameters": {
          "vnetName": { "value": "[variables('names').vnet]" },
          "nsgName": { "value": "[variables('names').nsg]" },
          "location": { "value": "[parameters('location')]" },
          "addressPrefix": { "value": "[parameters('vnetAddressPrefix')]" },
          "databricksPublicSubnetPrefix": { "value": "[parameters('databricksPublicSubnetPrefix')]" },
          "databricksPrivateSubnetPrefix": { "value": "[parameters('databricksPrivateSubnetPrefix')]" },
          "privateEndpointSubnetPrefix": { "value": "[parameters('privateEndpointSubnetPrefix')]" },
          "tags": { "value": "[variables('commonTags')]" }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[variables('deployments').logAnalytics]",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "relativePath": "modules/log-analytics.json"
        },
        "parameters": {
          "workspaceName": { "value": "[variables('names').logAnalytics]" },
          "location": { "value": "[parameters('location')]" },
          "retentionInDays": { "value": "[parameters('logRetentionInDays')]" },
          "dailyQuotaGb": { "value": "[parameters('logDailyQuotaGb')]" },
          "tags": { "value": "[variables('commonTags')]" }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[variables('deployments').storage]",
      "dependsOn": [
        "[variables('deployments').networking]",
        "[variables('deployments').logAnalytics]"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "relativePath": "modules/storage-account.json"
        },
        "parameters": {
          "storageAccountName": { "value": "[variables('names').storage]" },
          "location": { "value": "[parameters('location')]" },
          "skuName": { "value": "[parameters('storageSkuName')]" },
          "containerNames": { "value": "[parameters('storageContainerNames')]" },
          "coolTierAfterDays": { "value": "[parameters('coolTierAfterDays')]" },
          "deleteLandingAfterDays": { "value": "[parameters('deleteLandingAfterDays')]" },
          "softDeleteRetentionDays": { "value": "[if(variables('isProductionLike'), 30, 7)]" },
          "networkDefaultAction": { "value": "Deny" },
          "allowedIpRanges": { "value": "[parameters('allowedIpRanges')]" },
          "allowedSubnetIds": {
            "value": [
              "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('names').vnet, reference(variables('deployments').networking).outputs.databricksPublicSubnetName.value)]",
              "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('names').vnet, reference(variables('deployments').networking).outputs.databricksPrivateSubnetName.value)]"
            ]
          },
          "deployPrivateEndpoints": { "value": "[parameters('deployPrivateEndpoints')]" },
          "privateEndpointSubnetId": { "value": "[reference(variables('deployments').networking).outputs.privateEndpointSubnetId.value]" },
          "logAnalyticsWorkspaceId": { "value": "[reference(variables('deployments').logAnalytics).outputs.workspaceResourceId.value]" },
          "tags": { "value": "[variables('commonTags')]" }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[variables('deployments').keyVault]",
      "dependsOn": [
        "[variables('deployments').storage]"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "relativePath": "modules/key-vault.json"
        },
        "parameters": {
          "keyVaultName": { "value": "[variables('names').keyVault]" },
          "location": { "value": "[parameters('location')]" },
          "skuName": { "value": "[parameters('keyVaultSkuName')]" },
          "enablePurgeProtection": { "value": "[parameters('enableKeyVaultPurgeProtection')]" },
          "softDeleteRetentionInDays": { "value": "[if(variables('isProductionLike'), 90, 7)]" },
          "networkDefaultAction": { "value": "Deny" },
          "allowedIpRanges": { "value": "[parameters('allowedIpRanges')]" },
          "allowedSubnetIds": {
            "value": [
              "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('names').vnet, reference(variables('deployments').networking).outputs.databricksPublicSubnetName.value)]",
              "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('names').vnet, reference(variables('deployments').networking).outputs.databricksPrivateSubnetName.value)]"
            ]
          },
          "deployPrivateEndpoint": { "value": "[parameters('deployPrivateEndpoints')]" },
          "privateEndpointSubnetId": { "value": "[reference(variables('deployments').networking).outputs.privateEndpointSubnetId.value]" },
          "secretsObject": {
            "value": {
              "secrets": [
                {
                  "secretName": "[variables('spSecretName')]",
                  "secretValue": "[parameters('servicePrincipalClientSecret')]",
                  "contentType": "text/plain"
                },
                {
                  "secretName": "datalake-dfs-endpoint",
                  "secretValue": "[reference(variables('deployments').storage).outputs.dfsEndpoint.value]",
                  "contentType": "text/plain"
                },
                {
                  "secretName": "log-analytics-workspace-id",
                  "secretValue": "[reference(variables('deployments').logAnalytics).outputs.workspaceCustomerId.value]",
                  "contentType": "text/plain"
                }
              ]
            }
          },
          "logAnalyticsWorkspaceId": { "value": "[reference(variables('deployments').logAnalytics).outputs.workspaceResourceId.value]" },
          "tags": { "value": "[variables('commonTags')]" }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[variables('deployments').databricks]",
      "dependsOn": [
        "[variables('deployments').networking]",
        "[variables('deployments').logAnalytics]"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "relativePath": "modules/databricks-workspace.json"
        },
        "parameters": {
          "workspaceName": { "value": "[variables('names').databricks]" },
          "location": { "value": "[parameters('location')]" },
          "pricingTier": { "value": "[parameters('databricksPricingTier')]" },
          "managedResourceGroupName": { "value": "[variables('names').databricksManagedRg]" },
          "vnetId": { "value": "[reference(variables('deployments').networking).outputs.vnetId.value]" },
          "publicSubnetName": { "value": "[reference(variables('deployments').networking).outputs.databricksPublicSubnetName.value]" },
          "privateSubnetName": { "value": "[reference(variables('deployments').networking).outputs.databricksPrivateSubnetName.value]" },
          "enableNoPublicIp": { "value": true },
          "storageAccountSkuName": { "value": "[if(variables('isProductionLike'), 'Standard_GRS', 'Standard_LRS')]" },
          "logAnalyticsWorkspaceId": { "value": "[reference(variables('deployments').logAnalytics).outputs.workspaceResourceId.value]" },
          "tags": { "value": "[variables('commonTags')]" }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[variables('deployments').dataFactory]",
      "dependsOn": [
        "[variables('deployments').keyVault]"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "relativePath": "modules/data-factory.json"
        },
        "parameters": {
          "factoryName": { "value": "[variables('names').dataFactory]" },
          "location": { "value": "[parameters('location')]" },
          "enableManagedVirtualNetwork": { "value": true },
          "publicNetworkAccess": { "value": "Enabled" },
          "enableGitConfiguration": { "value": "[parameters('enableDataFactoryGit')]" },
          "gitAccountName": { "value": "[parameters('dataFactoryGit').accountName]" },
          "gitProjectName": { "value": "[parameters('dataFactoryGit').projectName]" },
          "gitRepositoryName": { "value": "[parameters('dataFactoryGit').repositoryName]" },
          "gitCollaborationBranch": { "value": "[parameters('dataFactoryGit').collaborationBranch]" },
          "gitRootFolder": { "value": "[parameters('dataFactoryGit').rootFolder]" },
          "keyVaultName": { "value": "[variables('names').keyVault]" },
          "keyVaultUri": { "value": "[reference(variables('deployments').keyVault).outputs.keyVaultUri.value]" },
          "dataLakeDfsEndpoint": { "value": "[reference(variables('deployments').storage).outputs.dfsEndpoint.value]" },
          "logAnalyticsWorkspaceId": { "value": "[reference(variables('deployments').logAnalytics).outputs.workspaceResourceId.value]" },
          "tags": { "value": "[variables('commonTags')]" }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[variables('deployments').keyVaultAccess]",
      "dependsOn": [
        "[variables('deployments').dataFactory]"
      ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "keyVaultName": { "value": "[variables('names').keyVault]" },
          "roleDefinitionId": { "value": "[variables('keyVaultSecretsUserRoleId')]" },
          "principalIds": {
            "value": "[union(createArray(reference(variables('deployments').dataFactory).outputs.principalId.value), parameters('keyVaultReaderPrincipalIds'))]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "description": "Grants Key Vault Secrets User on the platform vault to each principal. Kept inline because it is tiny and only meaningful alongside the orchestrator."
          },
          "parameters": {
            "keyVaultName": {
              "type": "string",
              "metadata": {
                "description": "Target Key Vault name."
              }
            },
            "roleDefinitionId": {
              "type": "string",
              "metadata": {
                "description": "GUID of the built-in role to assign."
              }
            },
            "principalIds": {
              "type": "array",
              "metadata": {
                "description": "Object IDs of the service principals or managed identities to grant."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[format('Microsoft.KeyVault/vaults/{0}', parameters('keyVaultName'))]",
              "name": "[guid(resourceGroup().id, parameters('keyVaultName'), parameters('roleDefinitionId'), parameters('principalIds')[copyIndex()])]",
              "copy": {
                "name": "roleAssignmentLoop",
                "count": "[length(parameters('principalIds'))]"
              },
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('roleDefinitionId'))]",
                "principalId": "[parameters('principalIds')[copyIndex()]]",
                "principalType": "ServicePrincipal"
              }
            }
          ],
          "outputs": {
            "assignmentCount": {
              "type": "int",
              "value": "[length(parameters('principalIds'))]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "environment": {
      "type": "string",
      "value": "[parameters('environment')]"
    },
    "resourceGroupName": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[reference(variables('deployments').storage).outputs.storageAccountName.value]"
    },
    "dataLakeDfsEndpoint": {
      "type": "string",
      "value": "[reference(variables('deployments').storage).outputs.dfsEndpoint.value]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[reference(variables('deployments').keyVault).outputs.keyVaultName.value]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(variables('deployments').keyVault).outputs.keyVaultUri.value]"
    },
    "databricksWorkspaceUrl": {
      "type": "string",
      "value": "[reference(variables('deployments').databricks).outputs.workspaceUrl.value]"
    },
    "dataFactoryName": {
      "type": "string",
      "value": "[reference(variables('deployments').dataFactory).outputs.factoryName.value]"
    },
    "dataFactoryPrincipalId": {
      "type": "string",
      "value": "[reference(variables('deployments').dataFactory).outputs.principalId.value]"
    },
    "logAnalyticsWorkspaceResourceId": {
      "type": "string",
      "value": "[reference(variables('deployments').logAnalytics).outputs.workspaceResourceId.value]"
    },
    "privateEndpointsDeployed": {
      "type": "bool",
      "value": "[parameters('deployPrivateEndpoints')]"
    },
    "keyVaultRoleAssignments": {
      "type": "int",
      "value": "[reference(variables('deployments').keyVaultAccess).outputs.assignmentCount.value]"
    }
  }
}
