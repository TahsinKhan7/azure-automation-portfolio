// ============================================================================
// Key Vault secrets near expiry
//
// Purpose : Give the platform team a weekly list of secrets that will expire
//           soon, prioritised by whether anything is still reading them.
// Sources :
//   1. KeyVaultSecretInventory_CL  - custom table populated by
//      powershell/storage/Export-KeyVaultSecrets.ps1 (metadata only, never
//      values) through a data collection rule. Columns: TimeGenerated,
//      VaultName_s, SecretName_s, Enabled_b, Created_t, Updated_t,
//      Expires_t, ContentType_s.
//   2. AzureDiagnostics - Key Vault AuditEvent category (ResourceProvider ==
//      "MICROSOFT.KEYVAULT"). Columns used: TimeGenerated, OperationName
//      (SecretGet, SecretList, ...), ResultType, id_s (secret URI),
//      CallerIPAddress, identity_claim_appid_g, Resource (vault name).
// Notes   : Key Vault itself does not log expiry; Event Grid emits
//           SecretNearExpiry events, but an inventory table lets the report
//           include secrets with no expiry set at all, which is the more
//           common compliance gap.
// ============================================================================

let WarningDays = 30;
let Inventory =
    KeyVaultSecretInventory_CL
    | summarize arg_max(TimeGenerated, *) by VaultName_s, SecretName_s   // latest snapshot per secret
    | project
        VaultName   = VaultName_s,
        SecretName  = SecretName_s,
        Enabled     = Enabled_b,
        Expires     = Expires_t,
        Updated     = Updated_t,
        ContentType = ContentType_s,
        SnapshotAt  = TimeGenerated
    | extend DaysToExpiry = datetime_diff('day', Expires, now())
    | extend ExpiryStatus = case(
        isnull(Expires),                 "No expiry set",
        DaysToExpiry < 0,                "Expired",
        DaysToExpiry <= WarningDays,     "Expiring soon",
                                         "Valid");

// --- 1. Secrets expiring within the warning window, with recent readers -----
let Readers =
    AzureDiagnostics
    | where TimeGenerated > ago(14d)
    | where ResourceProvider == "MICROSOFT.KEYVAULT" and OperationName == "SecretGet" and ResultType == "Success"
    | extend SecretName = tostring(split(id_s, "/")[4])
    | summarize
        Reads14d   = count(),
        LastRead   = max(TimeGenerated),
        CallerApps = make_set(identity_claim_appid_g, 5),
        CallerIPs  = make_set(CallerIPAddress, 5)
        by VaultName = Resource, SecretName;
Inventory
| where ExpiryStatus in ("Expiring soon", "Expired")
| join kind=leftouter Readers on VaultName, SecretName
| extend Reads14d = coalesce(Reads14d, 0)
| extend Priority = case(
    ExpiryStatus == "Expired" and Reads14d > 0,       "P1 - expired and in use",
    ExpiryStatus == "Expiring soon" and Reads14d > 0, "P2 - expiring and in use",
    ExpiryStatus == "Expired",                        "P3 - expired, unused",
                                                      "P4 - expiring, unused")
| project Priority, VaultName, SecretName, Expires, DaysToExpiry, Reads14d, LastRead, CallerApps, ContentType
| order by Priority asc, DaysToExpiry asc

// --- 2. Compliance gap: enabled secrets with no expiry date -----------------
Inventory
| where Enabled == true and ExpiryStatus == "No expiry set"
| project VaultName, SecretName, Updated, ContentType, AgeDays = datetime_diff('day', now(), Updated)
| order by AgeDays desc

// --- 3. Vault-level summary for the workbook tile ----------------------------
Inventory
| summarize
    Total        = count(),
    Expired      = countif(ExpiryStatus == "Expired"),
    ExpiringSoon = countif(ExpiryStatus == "Expiring soon"),
    NoExpiry     = countif(ExpiryStatus == "No expiry set"),
    LastSnapshot = max(SnapshotAt)
    by VaultName
| extend StaleInventory = LastSnapshot < ago(2d)   // the export job should run daily
| order by Expired desc, ExpiringSoon desc

// --- 4. Alert rule query: any P1/P2 secret (schedule daily, threshold > 0) --
Inventory
| where ExpiryStatus in ("Expiring soon", "Expired")
| join kind=inner (
    AzureDiagnostics
    | where TimeGenerated > ago(7d)
    | where ResourceProvider == "MICROSOFT.KEYVAULT" and OperationName == "SecretGet" and ResultType == "Success"
    | extend SecretName = tostring(split(id_s, "/")[4])
    | distinct VaultName = Resource, SecretName
) on VaultName, SecretName
| summarize SecretsAtRisk = count(), Examples = make_list(strcat(VaultName, "/", SecretName), 10)
